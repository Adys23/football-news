# Skopiuj do .env.local i uzupelnij. Nigdy nie commituj prawdziwych wartosci.

# --- Next.js / klient przegladarki ---
# Lokalnie: wartosci z `supabase start` (API na porcie 54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Produkcja (Vercel): https://<domena> bez koncowego / - z niego sa canonicale, sitemapy i RSS.
# NEXT_PUBLIC_* wchodza do builda: po zmianie na Vercelu potrzebny redeploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tylko serwer / Edge Functions. Nigdy w kodzie klienckim. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Tylko Edge Functions ---
OPENAI_API_KEY=

# Przelacznik pipeline'u AI. false = handlery uzywaja fixtures, bez kosztow i bez klucza.
LLM_ENABLED=false

# --- Webhook publikacji (Supabase -> /api/revalidate) ---
# Tylko serwer Next.js. Ta sama wartosc musi byc w Vault bazy jako revalidate_webhook_secret,
# obok revalidate_webhook_url (https://<strona>/api/revalidate) - patrz docs/runbook.md §8.
# Pusta wartosc: /api/revalidate odrzuca kazde zadanie (401). Wygeneruj: openssl rand -hex 32
REVALIDATE_WEBHOOK_SECRET=

# --- Tylko terminal osoby wdrazajacej: npm run deploy:supabase (docs/deployment.md) ---
# Nie wpisuj ich do .env.local ani do Vercela. Token: supabase.com/dashboard/account/tokens,
# haslo bazy: Project Settings -> Database.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# --- Opcjonalne: wymus pelna bramke db przy kazdym commicie ---
# STRICT_PRECOMMIT=1
