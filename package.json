{
  "name": "football-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:types": "node scripts/gen-types.mjs",
    "db:studio": "node scripts/open-studio.mjs",
    "test:db": "supabase test db",
    "env:local": "node scripts/write-env-local.mjs",
    "job:enqueue": "node scripts/job-enqueue.mjs",
    "job:replay": "node scripts/job-replay.mjs",
    "jobs:status": "node scripts/jobs-status.mjs",
    "source:test": "node scripts/source-test.mjs",
    "story:show": "node scripts/story-show.mjs",
    "llm:cost": "node scripts/llm-cost.mjs",
    "fixtures:list": "node scripts/fixtures-list.mjs",
    "ui:add": "shadcn add",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "verify:db": "node scripts/verify-db.mjs",
    "verify:all": "npm run verify && npm run verify:db && npm run test:pipeline",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
